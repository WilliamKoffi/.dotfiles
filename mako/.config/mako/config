# ─── Mako Notification Configuration ─────────────────────────────────────────

# Position & size
anchor=top-right
margin=12
width=340
height=120
padding=16

# Max visible notifications at once
max-visible=5
sort=-time

# ─── Appearance ───────────────────────────────────────────────────────────────
font=monospace 11
background-color=#343947eb
text-color=#ffffff
border-color=#9399b2cc
border-radius=10
border-size=2
markup=1
format=<b>%s</b>\n%b
icons=1
icon-location=left
icon-path=/usr/share/icons/hicolor

# ─── Timing ───────────────────────────────────────────────────────────────────
default-timeout=5000
ignore-timeout=0

# ─── Urgency Overrides ────────────────────────────────────────────────────────

[urgency=low]
border-color=#9399b299
default-timeout=3000

[urgency=high]
border-color=#e78a8ae6
background-color=#343947eb
default-timeout=0
