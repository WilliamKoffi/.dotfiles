/* ─── Tokyo Night — Top Bar Theme ──────────────────────────────────────────── */

/* Color palette */
* {
    /* Tokyo Night colors */
    bg0:        #1a1b26f2;   /* main background, slightly transparent */
    bg1:        #24283b;     /* input field / selected bg */
    bg2:        #292e42;     /* hover bg */
    fg0:        #c0caf5;     /* primary text */
    fg1:        #a9b1d6;     /* secondary text */
    accent:     #7aa2f7;     /* blue accent */
    accent2:    #bb9af7;     /* purple accent */
    urgent:     #f7768e;     /* red */
    green:      #9ece6a;
    border-col: #3d59a1;

    background-color: transparent;
    text-color:       @fg0;
}

/* ─── Window ─────────────────────────────────────────────────────────────────*/
window {
    transparency:     "real";
    background-color: @bg0;
    border:           1px;
    border-color:     @border-col;
    border-radius:    10px;

    /* Centered bar with top margin */
    location:         north;
    anchor:           north;
    x-offset:         0;
    y-offset:         12;
    width:            680px;
    padding:          0;
}

/* ─── Main box ───────────────────────────────────────────────────────────────*/
mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          8px 12px;
}

/* ─── Input bar ──────────────────────────────────────────────────────────────*/
inputbar {
    background-color: transparent;
    children:         [ prompt, textbox-prompt-colon, entry ];
    spacing:          0px;
    padding:          6px 0px;
    border:           0px 0px 1px;
    border-color:     @border-col;
    margin:           0px 0px 6px 0px;
}

prompt {
    background-color: transparent;
    text-color:       @accent2;
    padding:          0px 6px 0px 0px;
    font:             "JetBrainsMono Nerd Font 14";
    str:              " ";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @fg1;
    str:              "›  ";
    padding:          0px 4px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:       @fg0;
    placeholder:      "Search apps…";
    placeholder-color: @fg1;
    cursor:           text;
    padding:          0px;
}

/* ─── List view ──────────────────────────────────────────────────────────────*/
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          2px;
    scrollbar:        false;
    dynamic:          true;
    layout:           vertical;
    padding:          4px 0px 0px 0px;
}

/* ─── Elements ───────────────────────────────────────────────────────────────*/
element {
    background-color: transparent;
    text-color:       @fg1;
    orientation:      horizontal;
    padding:          6px 8px;
    border-radius:    6px;
    spacing:          10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg1;
}

element selected.normal {
    background-color: @bg1;
    text-color:       @fg0;
    border:           0px 0px 0px 2px;
    border-color:     @accent;
    border-radius:    6px;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg1;
}

element urgent.normal {
    background-color: @urgent;
    text-color:       @bg0;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg0;
}

element active.normal {
    text-color:       @accent;
}

element selected.active {
    background-color: @bg2;
    text-color:       @accent;
    border:           0px 0px 0px 2px;
    border-color:     @accent;
}

/* ─── Element parts ──────────────────────────────────────────────────────────*/
element-icon {
    background-color: transparent;
    size:             22px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold #7aa2f7;
    cursor:           inherit;
    vertical-align:   0.5;
}

/* ─── Message / no-entry ─────────────────────────────────────────────────────*/
error-message {
    background-color: @bg0;
    text-color:       @urgent;
    padding:          8px;
}
